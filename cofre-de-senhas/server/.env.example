# Porta em que o servidor escuta.
PORT=3001

# Origem permitida para requisições CORS — o endereço do frontend publicado.
# Em desenvolvimento local, o padrão já cobre o Vite.
ALLOWED_ORIGIN=http://localhost:5173

# Salt usado para gerar o hash dos IPs nos logs de segurança. Defina um
# valor único e secreto em produção (ex: gere com `openssl rand -hex 32`).
IP_HASH_SALT=troque-este-valor-em-producao

# Credencial de service account do Firebase, em formato JSON de uma linha
# só. Se não for definida, o servidor funciona normalmente, mas os logs de
# segurança e o endpoint /api/stats ficam desativados (só console.log local).
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço
# > Gerar nova chave privada.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# OBRIGATÓRIA para o Cofre Pessoal (vault) — segredo usado para assinar
# os JWTs de acesso das contas do cofre. Gere um valor único e forte em
# produção (ex: openssl rand -hex 32). Sem isso, o cadastro/login do
# cofre falha ao tentar emitir um token — o verificador de vazamento
# (HIBP) continua funcionando normalmente sem essa variável.
JWT_SECRET=troque-por-um-valor-aleatorio-longo-em-producao

# Caminho do arquivo do banco SQLite do Cofre Pessoal (contas e itens do
# vault). Use ":memory:" para testes. Não confundir com o Firestore —
# são bancos diferentes para partes diferentes do projeto.
DB_PATH=./data.sqlite

# URL de conexão com Redis, usada para tornar o rate limiting escalável
# entre múltiplas instâncias do backend. Se não for definida, o rate
# limiter cai para armazenamento em memória (funciona bem com uma única
# instância, que é o cenário padrão no Render free tier). Formato:
# redis://usuario:senha@host:porta
# REDIS_URL=redis://default:senha@seu-redis.upstash.io:6379
